<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.studioflow.server</string>
	<key>UserName</key>
	<string>_studioflow</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>-m</string>
		<string>server.app</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8766</string>
		<string>--database</string>
		<string>/Users/_studioflow/Library/Application Support/StudioFlow/platform.sqlite</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/opt/studioflow/app</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CODEX_HOME</key>
		<string>/Users/_studioflow/.codex</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Users/_studioflow/Library/Logs/StudioFlow/server.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/_studioflow/Library/Logs/StudioFlow/server-error.log</string>
</dict>
</plist>
