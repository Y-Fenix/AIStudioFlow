  "exclusions": [
    {
      "pattern": "GagaSort/Assets/**/Editor/**/*.cs",
      "reason": "本轮固定范围为游戏运行时业务；Editor工具实现不单独深审，关卡导出/校验/求解仍由LEVEL专项真实执行。"
    },
    {
      "pattern": "GagaSort/Assets/Scripts/AWFramework/Packages/**/*.cs",
      "reason": "第三方UISoftMask实现不逐行审计；项目调用、资源引用及UI边界仍归SYS-UI。"
    }
